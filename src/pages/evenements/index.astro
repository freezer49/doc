---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const evenements = (await getCollection('evenements')).sort(
	(a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={`Événements | ${SITE_TITLE}`} description="Tous les événements" />
	</head>
	<body>
		<Header />
		<main>
			<h1>Événements</h1>
			<ul>
				{evenements.map((evenement) => (
					<li>
						<a href={`${import.meta.env.BASE_URL}evenements/${evenement.id}/`}>
							<h4>{evenement.data.title}</h4>
							<p>{evenement.data.date.toLocaleDateString('fr-FR')} — {evenement.data.lieu}</p>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
