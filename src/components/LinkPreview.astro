---
import { getPreviewImage } from "../lib/link-preview";

interface Props {
  title: string;
  href: string;
  description?: string;
}

const { title, href, description } = Astro.props;
const domain = new URL(href).hostname.replace(/^www\./, "");
const favicon = `https://www.google.com/s2/favicons?domain=${domain}&sz=64`;
const image = await getPreviewImage(href);
---

<a class="link-preview not-content" href={href} target="_blank" rel="noopener noreferrer">
  <div class="thumb">
    {
      image ? (
        <img
          class="cover"
          src={image}
          alt=""
          loading="lazy"
          referrerpolicy="no-referrer"
          onerror={`this.onerror=null;this.className='icon';this.src='${favicon}'`}
        />
      ) : (
        <img class="icon" src={favicon} alt="" loading="lazy" />
      )
    }
  </div>
  <div class="body">
    <span class="title">{title}</span>
    {description && <span class="description">{description}</span>}
    <span class="domain">{domain} ↗</span>
  </div>
</a>

<style>
  .link-preview {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    padding: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-black);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s, background-color 0.15s;
  }
  .link-preview:hover {
    border-color: var(--sl-color-text-accent);
    background: var(--sl-color-gray-6);
  }
  .thumb {
    flex: none;
    display: grid;
    place-items: center;
    width: 10rem;
    aspect-ratio: 1.91 / 1;
    overflow: hidden;
    border-radius: 0.375rem;
    background: var(--sl-color-gray-6);
  }
  .thumb .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb .icon {
    width: 2.5rem;
    height: 2.5rem;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .title {
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .description {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .domain {
    margin-top: auto;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-text-accent);
  }
  @media (max-width: 30rem) {
    .link-preview {
      flex-direction: column;
    }
    .thumb {
      width: 100%;
    }
  }
</style>
